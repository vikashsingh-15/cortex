{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    
     "paths": {
       "@/*": ["src/*"]
    },
    
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/pipelines/ingestion-pipeline.ts",
    "src/pipelines/qa-overdoc.ts"
  ]
}

