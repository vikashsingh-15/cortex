# Local development values (keep these commented when preparing a production .env file).
# PORT=8000
# NODE_ENV=development
# CLIENT_ORIGIN=http://localhost:5173
# APP_URL=http://localhost:8000
# CALL_BACK_URL=http://localhost:8000/auth/google/callback
# SUCCESS_REDIRECT_URL=http://localhost:5173/auth/callback

# Render production values. Render provides PORT automatically; do not configure it in Render.
NODE_ENV=production
DB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
COOKIE_KEY=replace-with-a-long-random-secret
JWT_TOKEN_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_KEY=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://your-project.vercel.app
APP_URL=https://your-render-service.onrender.com
CALL_BACK_URL=https://your-render-service.onrender.com/auth/google/callback
SUCCESS_REDIRECT_URL=https://your-project.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
FIRE_WORKS_API_KEY=
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
TAVILY_API_KEY=
EXA_SEARCH_API_KEY=
ELEVEN_LAB_API_KEY=
